{
  "name": "agent-skillforge",
  "version": "0.4.0",
  "description": "Creator tooling for agent skills and plugins.",
  "type": "module",
  "bin": {
    "agent-skillforge": "dist/cli.js",
    "codex-skillforge": "dist/cli.js",
    "skillforge": "dist/cli.js",
    "asf": "dist/cli.js",
    "csf": "dist/cli.js"
  },
  "files": [
    "dist",
    "examples",
    "templates",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:fixtures": "tsx src/cli.ts lint tests/fixtures/valid-skill",
    "self:lint": "npm run build --silent && node dist/cli.js lint . --strict --profile marketplace",
    "check": "npm run format:check && npm run build && npm test && npm run self:lint",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/f0d010c/skillforge.git"
  },
  "bugs": {
    "url": "https://github.com/f0d010c/skillforge/issues"
  },
  "homepage": "https://github.com/f0d010c/skillforge#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "commander": "^14.0.3",
    "fs-extra": "^11.4.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "agent-skills",
    "codex",
    "claude-code",
    "openai",
    "skills",
    "plugins",
    "cli"
  ],
  "license": "MIT"
}
